/* =========================================================
   UNIVERSITY OF MOWTOWN
   STYLE.CSS
   ========================================================= */

:root {
  --bg: #07090d;
  --bg-soft: #0d1118;
  --panel: #11161e;
  --panel-2: #171d27;
  --panel-3: #1d2430;

  --cream: #e8dcc2;
  --cream-dark: #bba981;

  --white: #f5f5f2;
  --text: #d9dde3;
  --muted: #8993a1;

  --green: #6ee7a0;
  --red: #ff7272;
  --pink: #ff8db4;
  --blue: #7db9ff;

  --border: rgba(255,255,255,.09);

  --radius: 16px;

  --shadow:
    0 20px 70px rgba(0,0,0,.45);
}


/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 85% 5%,
      rgba(232,220,194,.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 15% 40%,
      rgba(80,100,140,.06),
      transparent 25%
    ),
    linear-gradient(
      180deg,
      #06080b 0%,
      #090c11 50%,
      #06080b 100%
    );

  color: var(--white);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #07090d;
}

::-webkit-scrollbar-thumb {
  background: #2a313d;
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: #3a4352;
}


/* =========================================================
   NAVBAR
   ========================================================= */

.navbar {
  height: 76px;

  position: sticky;
  top: 0;

  z-index: 1000;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 6vw;

  background: rgba(6,8,11,.86);

  backdrop-filter: blur(20px);

  border-bottom:
    1px solid var(--border);
}

.logo {
  display: flex;
  align-items: center;

  gap: 12px;
}

.logo-box {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border:
    1px solid var(--cream-dark);

  border-radius: 10px;

  color: var(--cream);

  font-size: 14px;

  font-weight: 900;

  letter-spacing: .05em;
}

.logo strong {
  display: block;

  font-size: 12px;

  letter-spacing: .12em;
}

.logo small {
  display: block;

  margin-top: 3px;

  color: var(--muted);

  font-size: 9px;

  letter-spacing: .13em;
}

.navbar nav {
  display: flex;

  align-items: center;

  gap: 27px;
}

.navbar nav a {
  position: relative;

  color: #b8bec7;

  font-size: 12px;

  transition: .2s;
}

.navbar nav a:hover {
  color: var(--cream);
}

.navbar nav a::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -7px;

  width: 0;
  height: 1px;

  background: var(--cream);

  transition: .25s;
}

.navbar nav a:hover::after {
  width: 100%;
}

.hamburger {
  display: none;

  width: 42px;
  height: 42px;

  background: transparent;

  border:
    1px solid var(--border);

  border-radius: 10px;

  color: white;

  font-size: 22px;
}


/* =========================================================
   COMMON
   ========================================================= */

.label {
  color: var(--cream-dark);

  font-size: 10px;

  font-weight: 900;

  letter-spacing: .18em;
}

.section {
  padding: 105px 7vw;
}

.dark-section {
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.015),
      rgba(255,255,255,.025)
    );

  border-top:
    1px solid var(--border);

  border-bottom:
    1px solid var(--border);
}

.section-title {
  display: flex;

  justify-content: space-between;

  align-items: end;

  gap: 40px;

  margin-bottom: 38px;
}

.section-title h2 {
  margin-top: 10px;

  font-size: clamp(32px,4vw,48px);

  letter-spacing: -.05em;
}

.section-title p {
  max-width: 400px;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.7;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.btn {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  min-height: 45px;

  padding: 0 20px;

  border-radius: 10px;

  font-size: 12px;

  font-weight: 800;

  transition:
    transform .2s,
    background .2s,
    border-color .2s;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn.primary {
  background: var(--cream);

  color: #15130f;

  border:
    1px solid var(--cream);
}

.btn.primary:hover {
  background: #f2e9d6;
}

.btn.secondary {
  background: transparent;

  color: white;

  border:
    1px solid var(--border);
}

.btn.secondary:hover {
  border-color: var(--cream-dark);
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
  min-height: 610px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 60px;

  padding: 90px 8vw 80px;

  position: relative;
}

.hero::before {
  content: "";

  position: absolute;

  width: 500px;
  height: 500px;

  right: -200px;
  top: -150px;

  background:
    radial-gradient(
      circle,
      rgba(232,220,194,.08),
      transparent 65%
    );

  pointer-events: none;
}

.hero-content {
  max-width: 760px;

  position: relative;

  z-index: 2;
}

.hero h1 {
  margin: 18px 0 25px;

  font-size: clamp(52px,7vw,92px);

  line-height: .92;

  letter-spacing: -.07em;
}

.hero h1 span {
  color: var(--cream);
}

.hero-content > p {
  max-width: 620px;

  color: var(--muted);

  font-size: 15px;

  line-height: 1.8;
}

.hero-buttons {
  display: flex;

  flex-wrap: wrap;

  gap: 12px;

  margin-top: 30px;
}

.hero-card {
  min-width: 250px;

  padding: 30px;

  background:
    linear-gradient(
      145deg,
      #171c24,
      #0c1016
    );

  border:
    1px solid var(--border);

  border-radius: 20px;

  box-shadow: var(--shadow);

  position: relative;

  z-index: 2;
}

.live-dot {
  color: var(--green);

  font-size: 10px;

  font-weight: 800;
}

.hero-card h2 {
  margin-top: 18px;

  font-size: 46px;

  letter-spacing: -.06em;
}

.hero-card p {
  color: var(--muted);

  font-size: 12px;

  margin-top: 3px;
}


/* =========================================================
   STATISTICS
   ========================================================= */

.statistics {
  display: grid;

  grid-template-columns:
    repeat(4,1fr);

  margin: 0 6vw;

  border-top:
    1px solid var(--border);

  border-bottom:
    1px solid var(--border);
}

.statistics > div {
  padding: 31px;

  border-right:
    1px solid var(--border);
}

.statistics > div:last-child {
  border-right: 0;
}

.statistics strong {
  display: block;

  color: var(--cream);

  font-size: 29px;

  letter-spacing: -.04em;
}

.statistics span {
  display: block;

  margin-top: 5px;

  color: var(--muted);

  font-size: 11px;
}


/* =========================================================
   CAMPUS
   ========================================================= */

.campus-grid {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 16px;
}

.campus-card {
  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #12171f,
      #0c1016
    );

  border:
    1px solid var(--border);

  border-radius: var(--radius);

  transition:
    transform .3s,
    border-color .3s;
}

.campus-card:hover {
  transform: translateY(-4px);

  border-color:
    rgba(232,220,194,.25);
}

.campus-card.big {
  grid-column: span 2;
}

.campus-card img {
  width: 100%;
  height: 225px;

  display: block;

  object-fit: cover;

  filter:
    brightness(.68)
    saturate(.8);

  transition:
    transform .5s,
    filter .5s;
}

.campus-card.big img {
  height: 290px;
}

.campus-card:hover img {
  transform: scale(1.025);

  filter:
    brightness(.85)
    saturate(.9);
}

.campus-card > div {
  padding: 20px;
}

.campus-card small {
  color: var(--cream-dark);

  font-size: 9px;

  letter-spacing: .13em;
}

.campus-card h3 {
  margin: 8px 0;

  font-size: 19px;
}

.campus-card p {
  color: var(--muted);

  font-size: 12px;

  line-height: 1.6;
}


/* =========================================================
   STUDY
   ========================================================= */

.study-grid {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 15px;
}

.study-card {
  min-height: 190px;

  padding: 25px;

  background:
    rgba(255,255,255,.025);

  border:
    1px solid var(--border);

  border-radius: var(--radius);

  transition: .25s;
}

.study-card:hover {
  transform: translateY(-4px);

  background:
    rgba(255,255,255,.04);

  border-color:
    rgba(232,220,194,.2);
}

.study-card > span {
  color: var(--cream-dark);

  font-size: 11px;
}

.study-card h3 {
  margin: 18px 0 9px;

  font-size: 19px;
}

.study-card p {
  color: var(--muted);

  font-size: 12px;

  line-height: 1.6;
}


/* =========================================================
   STUDENT TABLE
   ========================================================= */

.student-table-wrapper {
  overflow-x: auto;

  margin-bottom: 20px;

  border:
    1px solid var(--border);

  border-radius: 14px;
}

table {
  width: 100%;

  min-width: 650px;

  border-collapse: collapse;
}

th,
td {
  padding: 16px;

  text-align: left;

  border-bottom:
    1px solid var(--border);

  font-size: 13px;
}

th {
  color: var(--muted);

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .12em;
}

tbody tr:last-child td {
  border-bottom: 0;
}

td:last-child {
  color: var(--cream);

  font-weight: 800;
}


/* =========================================================
   LEADERBOARD
   ========================================================= */

.leaderboard {
  overflow: hidden;

  border:
    1px solid var(--border);

  border-radius: 14px;
}

.leader-row {
  display: grid;

  grid-template-columns:
    50px
    1.5fr
    1fr
    100px;

  align-items: center;

  min-height: 61px;

  padding: 0 20px;

  border-bottom:
    1px solid var(--border);
}

.leader-row:last-child {
  border-bottom: 0;
}

.leader-row.header {
  min-height: 48px;

  background:
    rgba(255,255,255,.025);

  color: var(--muted);

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .1em;
}

.leader-row:not(.header) {
  font-size: 13px;
}

.leader-row:not(.header) > span:last-child {
  color: var(--cream);

  font-weight: 900;
}


/* =========================================================
   BUS
   ========================================================= */

.bus-panel {
  padding: 25px;

  background:
    linear-gradient(
      145deg,
      #111720,
      #0b0f15
    );

  border:
    1px solid var(--border);

  border-radius: 20px;

  box-shadow: var(--shadow);
}

.bus-controls {
  display: grid;

  grid-template-columns:
    1fr 1fr auto;

  align-items: end;

  gap: 15px;

  margin-bottom: 30px;
}

.bus-controls label {
  display: flex;

  flex-direction: column;

  gap: 8px;

  color: var(--muted);

  font-size: 10px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .08em;
}

.bus-controls select {
  width: 100%;

  height: 45px;

  padding: 0 13px;

  color: white;

  background: #171d26;

  border:
    1px solid var(--border);

  border-radius: 9px;

  outline: none;
}

.bus-controls select:focus {
  border-color: var(--cream-dark);
}

.women-bus-toggle {
  height: 45px;

  padding: 0 15px;

  flex-direction: row !important;

  align-items: center;

  justify-content: center;

  background:
    rgba(255,141,180,.08);

  border:
    1px solid rgba(255,141,180,.2);

  border-radius: 9px;

  color: var(--pink) !important;

  text-transform: none !important;

  letter-spacing: 0 !important;
}

.women-bus-toggle input {
  accent-color: var(--pink);
}


/* =========================================================
   SEAT MAP
   ========================================================= */

.seat-section {
  max-width: 620px;

  margin: auto;

  padding: 30px;

  background:
    #080b10;

  border:
    1px solid var(--border);

  border-radius: 18px;
}

.bus-front {
  width: 100%;

  height: 42px;

  display: grid;

  place-items: center;

  margin-bottom: 25px;

  color: var(--muted);

  background:
    #151b24;

  border:
    1px solid var(--border);

  border-radius: 9px;

  font-size: 9px;

  letter-spacing: .15em;
}

.seat-map {
  display: grid;

  grid-template-columns:
    repeat(4,1fr);

  gap: 11px;

  max-width: 360px;

  margin: auto;
}

.seat {
  min-height: 42px;

  display: grid;

  place-items: center;

  border:
    1px solid rgba(255,255,255,.13);

  border-radius: 8px;

  background:
    #18202a;

  color: #cbd1d8;

  font-size: 11px;

  font-weight: 800;

  transition: .15s;
}

.seat.available {
  cursor: pointer;
}

.seat.available:hover {
  transform: translateY(-2px);

  border-color: var(--cream);

  color: var(--cream);
}

.seat.selected {
  background: var(--cream);

  color: #15130f;

  border-color: var(--cream);
}

.seat.booked {
  background:
    #3a2025;

  color:
    #ff8383;

  border-color:
    rgba(255,114,114,.25);

  cursor: not-allowed;

  opacity: .75;
}

.seat.accessible {
  border-color:
    rgba(125,185,255,.45);

  color:
    var(--blue);
}

.seat.women {
  background:
    rgba(255,141,180,.12);

  border-color:
    rgba(255,141,180,.4);

  color:
    var(--pink);
}

.seat-info {
  display: flex;

  justify-content: center;

  flex-wrap: wrap;

  gap: 15px;

  margin-top: 25px;
}

.seat-info span {
  display: flex;

  align-items: center;

  gap: 6px;

  color: var(--muted);

  font-size: 9px;
}

.seat-info .seat {
  width: 13px;
  height: 13px;

  min-height: 13px;

  border-radius: 3px;
}

.booking-box {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  margin-top: 25px;

  padding: 20px;

  background:
    rgba(255,255,255,.025);

  border:
    1px solid var(--border);

  border-radius: 13px;
}

.booking-box strong {
  display: block;

  margin-top: 5px;

  color: var(--cream);

  font-size: 18px;
}


/* =========================================================
   E-TICKET
   ========================================================= */

.ticket-section {
  background:
    #080b10;

  border-top:
    1px solid var(--border);
}

.ticket {
  max-width: 900px;

  margin: auto;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #eee4cf,
      #cdbd9c
    );

  color: #15130f;

  border-radius: 18px;

  box-shadow:
    0 30px 90px rgba(0,0,0,.45);
}

.ticket-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  padding: 20px 25px;

  border-bottom:
    1px dashed rgba(0,0,0,.35);

  font-size: 11px;

  letter-spacing: .1em;
}

.ticket-main {
  display: flex;

  justify-content: space-between;

  gap: 30px;

  padding: 30px;
}

.ticket-data {
  flex: 1;

  display: grid;

  grid-template-columns:
    repeat(2,1fr);

  gap: 22px;
}

.ticket-data small {
  display: block;

  margin-bottom: 5px;

  font-size: 8px;

  font-weight: 800;

  opacity: .65;

  letter-spacing: .1em;
}

.ticket-data strong {
  font-size: 13px;
}

.barcode {
  width: 180px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  gap: 10px;
}

#barcodeGraphic {
  width: 170px;

  height: 70px;

  display: flex;

  align-items: stretch;

  gap: 2px;

  overflow: hidden;

  background: white;

  padding: 7px;
}

.bar {
  height: 100%;

  background: #111;
}

.barcode small {
  font-size: 8px;

  letter-spacing: .12em;
}


/* =========================================================
   LIVE CAMPUS MAP
   ========================================================= */

.live-map-container {
  max-width: 1100px;

  margin: 35px auto 0;

  padding: 20px;

  background:
    #0d1219;

  border:
    1px solid var(--border);

  border-radius: 20px;

  box-shadow: var(--shadow);
}

.map-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 18px;
}

.map-header h3 {
  margin-top: 5px;

  font-size: 24px;
}

.bus-status {
  color: var(--green);

  font-size: 9px;

  font-weight: 900;

  letter-spacing: .08em;
}


/*
  MAP AREA
*/

.campus-map {
  height: 540px;

  position: relative;

  overflow: hidden;

  border:
    1px solid rgba(255,255,255,.08);

  border-radius: 15px;

  background:
    radial-gradient(
      circle at 20% 30%,
      rgba(100,130,90,.14),
      transparent 20%
    ),
    radial-gradient(
      circle at 80% 70%,
      rgba(100,130,90,.1),
      transparent 22%
    ),
    #17231b;
}


/* GRID MAP */

.campus-map::before {
  content: "";

  position: absolute;

  inset: 0;

  opacity: .08;

  background-image:
    linear-gradient(
      rgba(255,255,255,.25) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.25) 1px,
      transparent 1px
    );

  background-size:
    35px 35px;
}


/* ROAD */

.road {
  position: absolute;

  background:
    #3b4141;

  box-shadow:
    inset 0 0 0 2px #252b2b;

  border-radius: 30px;
}

.road1 {
  width: 90%;

  height: 38px;

  left: 5%;

  top: 48%;
}

.road2 {
  width: 38px;

  height: 75%;

  left: 46%;

  top: 12%;

  transform: rotate(7deg);
}

.road3 {
  width: 70%;

  height: 32px;

  right: 3%;

  top: 25%;

  transform: rotate(-12deg);
}


/* BUILDINGS */

.building {
  position: absolute;

  min-width: 125px;

  min-height: 70px;

  padding: 12px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  gap: 4px;

  background:
    linear-gradient(
      145deg,
      #3b4350,
      #202732
    );

  border:
    1px solid rgba(255,255,255,.12);

  border-radius: 8px;

  box-shadow:
    0 15px 25px rgba(0,0,0,.3);

  text-align: center;

  z-index: 4;

  font-size: 20px;
}

.building span {
  color: #d6dbe0;

  font-size: 7px;

  font-weight: 900;

  letter-spacing: .08em;
}

.rectorate {
  top: 8%;
  left: 8%;
}

.engineering {
  bottom: 10%;
  left: 8%;
}

.medicine {
  top: 8%;
  right: 8%;
}

.computer {
  bottom: 10%;
  right: 8%;
}

.library {
  top: 30%;
  left: 7%;
}

.student-center {
  top: 30%;
  right: 7%;
}


/* TREES */

.tree {
  position: absolute;

  z-index: 5;

  font-size: 25px;

  filter:
    drop-shadow(
      0 7px 4px rgba(0,0,0,.45)
    );

  user-select: none;
}

.tree1 { left: 29%; top: 10%; }
.tree2 { left: 36%; top: 20%; }
.tree3 { left: 25%; bottom: 17%; }
.tree4 { left: 40%; bottom: 10%; }
.tree5 { right: 31%; top: 15%; }
.tree6 { right: 23%; top: 38%; }
.tree7 { right: 36%; bottom: 15%; }
.tree8 { left: 55%; bottom: 8%; }


/* BUS STOPS */

.bus-stop {
  position: absolute;

  z-index: 8;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 3px;

  color: var(--cream);

  font-size: 18px;

  text-shadow:
    0 2px 8px #000;
}

.bus-stop span {
  padding: 4px 7px;

  background:
    rgba(0,0,0,.7);

  border-radius: 5px;

  font-size: 7px;

  font-weight: 800;

  white-space: nowrap;
}

.stop1 {
  left: 17%;
  top: 44%;
}

.stop2 {
  left: 43%;
  top: 44%;
}

.stop3 {
  right: 28%;
  top: 44%;
}

.stop4 {
  right: 10%;
  top: 44%;
}


/* MOVING BUS */

.moving-bus {
  position: absolute;

  left: 13%;

  top: calc(48% - 15px);

  z-index: 15;

  width: 42px;

  height: 30px;

  display: grid;

  place-items: center;

  font-size: 27px;

  filter:
    drop-shadow(
      0 5px 8px rgba(0,0,0,.7)
    );

  transition:
    left 1.5s linear,
    top 1.5s linear;
}


/* MAP PIN */

.map-pin {
  position: absolute;

  right: 25px;

  top: 20px;

  z-index: 20;

  display: flex;

  align-items: center;

  gap: 6px;

  padding: 9px 12px;

  color: white;

  background:
    rgba(8,10,13,.8);

  border:
    1px solid var(--border);

  border-radius: 8px;

  font-size: 13px;

  backdrop-filter: blur(10px);
}

.map-pin span {
  font-size: 9px;

  color: var(--muted);
}


/* MAP INFO */

.map-info {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  margin-top: 12px;

  border:
    1px solid var(--border);

  border-radius: 10px;

  overflow: hidden;
}

.map-info > div {
  padding: 17px;

  border-right:
    1px solid var(--border);
}

.map-info > div:last-child {
  border-right: 0;
}

.map-info small {
  display: block;

  color: var(--muted);

  font-size: 8px;

  letter-spacing: .1em;
}

.map-info strong {
  display: block;

  margin-top: 5px;

  font-size: 13px;

  color: var(--cream);
}


/* =========================================================
   ADMISSION
   ========================================================= */

.admission-grid {
  display: grid;

  grid-template-columns:
    repeat(4,1fr);

  gap: 14px;

  margin-bottom: 30px;
}

.admission-grid > div {
  min-height: 200px;

  padding: 24px;

  background:
    rgba(255,255,255,.025);

  border:
    1px solid var(--border);

  border-radius: 15px;
}

.admission-grid span {
  color: var(--cream-dark);

  font-size: 10px;
}

.admission-grid h3 {
  margin: 20px 0 9px;

  font-size: 17px;
}

.admission-grid p {
  color: var(--muted);

  font-size: 12px;

  line-height: 1.6;
}


/* =========================================================
   FOOTER
   ========================================================= */

footer {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  padding: 45px 7vw;

  border-top:
    1px solid var(--border);

  color: var(--muted);

  font-size: 11px;
}

.footer-brand {
  display: flex;

  align-items: center;

  gap: 12px;
}

.footer-brand strong {
  color: white;

  font-size: 11px;
}

.footer-brand p {
  margin-top: 4px;
}


/* =========================================================
   STUDENT DRAWER
   ========================================================= */

.drawer-backdrop {
  display: none;

  position: fixed;

  inset: 0;

  z-index: 1100;

  background:
    rgba(0,0,0,.65);
}

.drawer-backdrop.show {
  display: block;
}

.student-drawer {
  position: fixed;

  right: -540px;

  top: 0;
  bottom: 0;

  width: min(540px,94vw);

  z-index: 1200;

  padding: 25px;

  overflow-y: auto;

  background:
    #0d1219;

  border-left:
    1px solid var(--border);

  box-shadow:
    -25px 0 80px rgba(0,0,0,.5);

  transition:
    right .3s ease;
}

.student-drawer.open {
  right: 0;
}

.drawer-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 20px;
}

.drawer-header h2 {
  font-size: 25px;
}

.drawer-header button {
  width: 40px;
  height: 40px;

  background: transparent;

  border:
    1px solid var(--border);

  border-radius: 9px;

  color: white;

  font-size: 25px;
}

#studentSearch {
  width: 100%;

  height: 46px;

  padding: 0 14px;

  background:
    #171d26;

  color: white;

  border:
    1px solid var(--border);

  border-radius: 9px;

  outline: none;
}

#studentSearch:focus {
  border-color:
    var(--cream-dark);
}

.search-result-count {
  margin: 15px 0;

  color: var(--muted);

  font-size: 10px;
}

.student-result {
  display: flex;

  justify-content: space-between;

  gap: 15px;

  padding: 16px 0;

  border-bottom:
    1px solid var(--border);
}

.student-result strong {
  display: block;

  font-size: 13px;
}

.student-result small {
  display: block;

  margin-top: 5px;

  color: var(--muted);

  font-size: 10px;
}

.student-score {
  color: var(--cream);

  font-weight: 900;
}

.pagination {
  display: flex;

  flex-wrap: wrap;

  gap: 6px;

  margin-top: 20px;
}

.page-button {
  min-width: 34px;

  height: 34px;

  background:
    #171d26;

  color: white;

  border:
    1px solid var(--border);

  border-radius: 7px;

  font-size: 10px;
}

.page-button.active {
  background:
    var(--cream);

  color: #15130f;

  border-color:
    var(--cream);
}


/* =========================================================
   MODAL
   ========================================================= */

.modal {
  display: none;

  position: fixed;

  inset: 0;

  z-index: 1500;

  align-items: center;

  justify-content: center;

  padding: 20px;

  background:
    rgba(0,0,0,.72);

  backdrop-filter: blur(8px);
}

.modal.show {
  display: flex;
}

.modal-box {
  position: relative;

  width: min(500px,100%);

  padding: 30px;

  background:
    linear-gradient(
      145deg,
      #151b24,
      #0d1117
    );

  border:
    1px solid var(--border);

  border-radius: 18px;

  box-shadow:
    0 30px 100px rgba(0,0,0,.65);
}

.modal-box h2 {
  margin: 10px 0 25px;

  font-size: 32px;

  letter-spacing: -.05em;
}

.modal-close {
  position: absolute;

  top: 18px;
  right: 18px;

  width: 38px;
  height: 38px;

  background: transparent;

  border:
    1px solid var(--border);

  border-radius: 8px;

  color: white;

  font-size: 22px;
}

.modal-box input,
.modal-box select {
  width: 100%;

  height: 46px;

  margin-bottom: 12px;

  padding: 0 13px;

  color: white;

  background:
    #171d26;

  border:
    1px solid var(--border);

  border-radius: 9px;

  outline: none;
}

.modal-box input:focus,
.modal-box select:focus {
  border-color:
    var(--cream-dark);
}

.modal-box .btn {
  width: 100%;

  margin-top: 5px;
}

.exam-card-result {
  margin-top: 20px;

  padding: 20px;

  background:
    rgba(232,220,194,.08);

  border:
    1px solid rgba(232,220,194,.2);

  border-radius: 12px;
}

.exam-card-result h3 {
  margin-bottom: 15px;

  color: var(--cream);
}

.exam-card-result p {
  color: var(--muted);

  font-size: 12px;

  margin-top: 8px;
}

.exam-card-result strong {
  color: white;
}


/* =========================================================
   HIDDEN
   ========================================================= */

[hidden] {
  display: none !important;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

  .hero {
    padding-left: 6vw;
    padding-right: 6vw;
  }

  .section {
    padding-left: 6vw;
    padding-right: 6vw;
  }

  .campus-grid {
    grid-template-columns:
      repeat(2,1fr);
  }

  .campus-card.big {
    grid-column: span 2;
  }

  .study-grid {
    grid-template-columns:
      repeat(2,1fr);
  }

  .admission-grid {
    grid-template-columns:
      repeat(2,1fr);
  }

}


@media (max-width: 800px) {

  .navbar nav {
    display: none;

    position: absolute;

    top: 76px;

    left: 0;
    right: 0;

    padding: 22px 7vw;

    flex-direction: column;

    gap: 20px;

    background:
      #0a0d12;

    border-bottom:
      1px solid var(--border);
  }

  .navbar nav.open {
    display: flex;
  }

  .hamburger {
    display: block;
  }

  .hero {
    display: block;

    padding-top: 70px;
  }

  .hero-card {
    margin-top: 45px;

    max-width: 330px;
  }

  .statistics {
    grid-template-columns:
      repeat(2,1fr);

    margin: 0;
  }

  .statistics > div {
    border-bottom:
      1px solid var(--border);
  }

  .section-title {
    display: block;
  }

  .section-title p {
    margin-top: 15px;
  }

  .bus-controls {
    grid-template-columns: 1fr;
  }

  .campus-map {
    height: 470px;
  }

  .ticket-main {
    flex-direction: column;
  }

  .barcode {
    width: 100%;
  }

}


@media (max-width: 600px) {

  .campus-grid,
  .study-grid,
  .admission-grid {
    grid-template-columns: 1fr;
  }

  .campus-card.big {
    grid-column: span 1;
  }

  .campus-card img,
  .campus-card.big img {
    height: 210px;
  }

  .hero h1 {
    font-size: 55px;
  }

  .section {
    padding-top: 75px;
    padding-bottom: 75px;
  }

  .seat-section {
    padding: 18px;
  }

  .seat-map {
    gap: 7px;
  }

  .booking-box {
    flex-direction: column;

    align-items: stretch;
  }

  .booking-box .btn {
    width: 100%;
  }

  .ticket-data {
    grid-template-columns: 1fr;
  }

  .campus-map {
    height: 430px;
  }

  .building {
    min-width: 80px;
    min-height: 52px;

    padding: 6px;

    font-size: 15px;
  }

  .building span {
    font-size: 5px;
  }

  .tree {
    font-size: 19px;
  }

  .map-info {
    grid-template-columns: 1fr;
  }

  .map-info > div {
    border-right: 0;

    border-bottom:
      1px solid var(--border);
  }

  .map-info > div:last-child {
    border-bottom: 0;
  }

  footer {
    flex-direction: column;

    align-items: flex-start;
  }

}


@media (max-width: 430px) {

  .logo strong {
    font-size: 9px;
  }

  .logo small {
    font-size: 7px;
  }

  .hero h1 {
    font-size: 48px;
  }

  .statistics strong {
    font-size: 24px;
  }

  .seat-map {
    max-width: 280px;
  }

  .seat {
    min-height: 38px;
  }

}
/* =========================================================
   UNIVERSITY OF MOWTOWN — VISUAL POLISH
   paste di PALING BAWAH style.css
========================================================= */

:root {
  --mow-ink: #111827;
  --mow-muted: #667085;
  --mow-paper: #f7f7f4;
  --mow-white: #ffffff;
  --mow-line: rgba(17, 24, 39, 0.1);
  --mow-gold: #b08a45;
  --mow-gold-light: #d8bd82;
  --mow-green: #173f35;
  --mow-green-light: #23594b;
  --mow-shadow: 0 20px 60px rgba(17, 24, 39, 0.09);
  --mow-radius: 24px;
}

html {
  scroll-behavior: smooth;
}

body {
  background:
    radial-gradient(
      circle at 10% 5%,
      rgba(176, 138, 69, 0.07),
      transparent 28%
    ),
    var(--mow-paper);

  color: var(--mow-ink);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

* {
  box-sizing: border-box;
}

img {
  display: block;
  max-width: 100%;
}

a,
button,
input,
select {
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

/* =========================
   NAVBAR
========================= */

nav {
  background: rgba(255, 255, 255, 0.9) !important;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--mow-line);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.035);
}

nav a {
  position: relative;
  text-decoration: none;
}

nav a::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -7px;
  width: 0;
  height: 2px;
  background: var(--mow-gold);
  transform: translateX(-50%);
  transition: width 0.25s ease;
}

nav a:hover::after {
  width: 70%;
}

/* =========================
   HERO
========================= */

section:first-of-type {
  position: relative;
  overflow: hidden;
}

section:first-of-type::before {
  content: "";
  position: absolute;
  width: 450px;
  height: 450px;
  right: -180px;
  top: -180px;
  border-radius: 50%;

  background: radial-gradient(
    circle,
    rgba(176, 138, 69, 0.16),
    transparent 70%
  );

  pointer-events: none;
}

section:first-of-type h1 {
  letter-spacing: -0.045em;
  line-height: 0.98;
  text-wrap: balance;
}

section:first-of-type p {
  color: var(--mow-muted);
}

/* =========================
   BUTTONS
========================= */

button {
  border-radius: 999px;
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(17, 24, 39, 0.12);
}

button:active {
  transform: translateY(0);
}

/* =========================
   SECTION
========================= */

section {
  position: relative;
  scroll-margin-top: 90px;
}

section h2 {
  letter-spacing: -0.035em;
  line-height: 1.05;
}

section h3 {
  letter-spacing: -0.02em;
}

/* =========================
   CARDS
========================= */

section article,
section [class*="card"],
section [class*="Card"] {
  border-color: var(--mow-line);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

section article:hover,
section [class*="card"]:hover,
section [class*="Card"]:hover {
  transform: translateY(-5px);

  box-shadow: var(--mow-shadow);

  border-color: rgba(176, 138, 69, 0.28);
}

/* =========================
   IMAGES
========================= */

section img {
  border-radius: 20px;
  object-fit: cover;

  transition:
    transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
    filter 0.35s ease;
}

section img:hover {
  transform: scale(1.025);
  filter: saturate(1.08);
}

/* =========================
   STATISTICS
========================= */

section:first-of-type strong,
section:first-of-type b {
  font-variant-numeric: tabular-nums;
}

/* =========================
   ACADEMIC SECTION
========================= */

section:nth-of-type(3) {
  background:
    linear-gradient(
      135deg,
      rgba(23, 63, 53, 0.035),
      transparent 55%
    );
}

/* =========================
   TABLE
========================= */

table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;

  overflow: hidden;

  border: 1px solid var(--mow-line);
  border-radius: 20px;

  background: var(--mow-white);

  box-shadow: 0 12px 40px rgba(17, 24, 39, 0.055);
}

thead th {
  background: #f1f1ec;
  color: var(--mow-ink);
  font-weight: 700;
  letter-spacing: 0.03em;
}

th,
td {
  padding: 15px 18px;
  border-bottom: 1px solid var(--mow-line);
}

tbody tr:last-child td {
  border-bottom: 0;
}

tbody tr {
  transition: background 0.2s ease;
}

tbody tr:hover {
  background: rgba(176, 138, 69, 0.055);
}

/* =========================
   FORM
========================= */

input,
select {
  width: 100%;
  min-height: 48px;

  border: 1px solid rgba(17, 24, 39, 0.13);
  border-radius: 14px;

  background: rgba(255, 255, 255, 0.92);

  padding: 0 15px;

  color: var(--mow-ink);
  outline: none;
}

input::placeholder {
  color: #98a0ad;
}

input:hover,
select:hover {
  border-color: rgba(176, 138, 69, 0.5);
}

input:focus,
select:focus {
  border-color: var(--mow-gold);

  box-shadow:
    0 0 0 4px rgba(176, 138, 69, 0.12);
}

/* =========================
   BUS SYSTEM
========================= */

[class*="bus"],
[id*="bus"] {
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

[class*="bus"]:hover,
[id*="bus"]:hover {
  transform: translateY(-3px);
}

/* =========================
   MAP
========================= */

[class*="map"],
[id*="map"] {
  border-radius: 24px;
  overflow: hidden;
}

/* =========================
   WOMEN'S BUS
========================= */

input[type="checkbox"]:checked {
  accent-color: #d96c91;
}

/* =========================
   TICKET
========================= */

[class*="ticket"],
[id*="ticket"] {
  border-radius: 24px;

  border: 1px solid rgba(176, 138, 69, 0.22);

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.98),
      rgba(247, 247, 244, 0.96)
    );

  box-shadow: var(--mow-shadow);
}

/* =========================
   MODAL
========================= */

dialog,
[class*="modal"],
[class*="Modal"] {
  border-radius: 28px;

  border: 1px solid var(--mow-line);

  box-shadow:
    0 35px 100px rgba(0, 0, 0, 0.2);
}

dialog::backdrop {
  background: rgba(10, 15, 20, 0.55);
  backdrop-filter: blur(8px);
}

/* =========================
   FOOTER
========================= */

footer {
  border-top: 1px solid var(--mow-line);

  background: #101d1a;

  color: rgba(255, 255, 255, 0.82);
}

footer a {
  color: rgba(255, 255, 255, 0.72);
}

footer a:hover {
  color: white;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 768px) {

  body {
    overflow-x: hidden;
  }

  section {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }

  section:first-of-type h1 {
    font-size: clamp(3rem, 15vw, 5rem);
  }

  h2 {
    font-size: clamp(2rem, 9vw, 3rem);
  }

  section img {
    border-radius: 16px;
  }

  nav {
    padding-left: 18px;
    padding-right: 18px;
  }

  table {
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 12px 10px;
  }
}

/* =========================
   SMALL PHONE
========================= */

@media (max-width: 480px) {

  section:first-of-type h1 {
    font-size: 3.1rem;
  }

  button {
    min-height: 46px;
  }

  input,
  select {
    min-height: 50px;
  }
}

/* =========================
   ACCESSIBILITY
========================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }

}
